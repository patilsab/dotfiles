[global_config]
  dbus = False
  focus = mouse
  scroll_tabbar = True
  homogeneous_tabbar = False
  enabled_plugins = LaunchpadBugURLHandler, LaunchpadCodeURLHandler, APTURLHandler, TerminatorThemes
[keybindings]
  new_tab = <Primary>t
  close_term = <Primary><Shift>w
  paste = <Primary>v
  close_window = <Primary><Shift>w
  next_tab = <Primary>Tab
  prev_tab = <Primary><Shift>Tab
[profiles]
  [[default]]
    background_darkness = 0.85
    cursor_fg_color = "#eef9f9"
    cursor_bg_color = "#eef9f9"
    cursor_color_default = False
    font = JetBrainsMono Nerd Font Propo Medium 10
    scrollback_infinite = True
    disable_mousewheel_zoom = True
    palette = "#282828:#cc241d:#98971a:#d79921:#458588:#b16286:#689d6a:#a89984:#928374:#fb4934:#b8bb26:#fabd2f:#83a598:#d3869b:#8ec07c:#ebdbb2"
    use_system_font = False
    copy_on_selection = True
    title_transmit_fg_color = "#010202"
    title_transmit_bg_color = "#010202"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
